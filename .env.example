# ─────────────────────────────────────────────────────────────────────
# Moka Réservation — variables d'environnement
# Copier en .env.local pour le développement. Ne JAMAIS committer de vraies valeurs.
# Détail et procédure : docs/SETUP.md
# ─────────────────────────────────────────────────────────────────────

# ── Communes (production ET démo) ────────────────────────────────────
# production | demo | development
NEXT_PUBLIC_APP_ENV=development
# URL publique de l'application (liens des emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé « publishable » (sb_publishable_...) ou ancienne clé « anon » — publique par nature
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Emails de réservation (production, facultatif — voir docs/SETUP.md §5) ──
# Sans ces deux variables : aucun email envoyé (la réservation fonctionne quand même).
# RESEND_API_KEY=
# EMAIL_FROM="Moka Réservation <reservations@votre-domaine.fr>"

# ── Déplacements (Sprint 5) — clé de signature des trajets ──
# Copier la valeur de private.app_secrets (nom 'travel_signing') : voir docs/SETUP.md §6.
# Sans elle, les déplacements ne peuvent pas être activés.
# TRAVEL_SIGNING_SECRET=

# ── Paiement en ligne (Sprint 6) — Stripe Connect, voir docs/SETUP.md §7 ──
# Clé secrète Stripe : sk_test_… (une clé sk_live_ est refusée hors production)
# STRIPE_SECRET_KEY=
# Secret du webhook « Events on Connected accounts » : whsec_…
# STRIPE_WEBHOOK_SECRET=
# Secret des tâches planifiées (réconciliation Stripe ; aussi utilisé par la démo)
# CRON_SECRET=

# ── Démo UNIQUEMENT (ne pas définir en production) ───────────────────
# Clé secrète : serveur uniquement, jamais préfixée NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=
# Identifiant du projet Supabase démo (la partie xxxx de https://xxxx.supabase.co)
# DEMO_SUPABASE_PROJECT_REF=
# Identifiant du projet Supabase de PRODUCTION (garde-fou : la démo refuse de le toucher)
# PRODUCTION_SUPABASE_PROJECT_REF=
# Compte de démonstration recréé à chaque réinitialisation
# DEMO_USER_EMAIL=demo@moka-reservation.demo
# DEMO_USER_PASSWORD=
# Secret de la réinitialisation (32 caractères aléatoires minimum)
# CRON_SECRET=
